# Modelo de secrets. NÃO preencha aqui e NÃO commite o arquivo real.
#
# Localmente você nem precisa deste arquivo — sem ele, o app usa o SQLite
# (finance.db). Ele só é necessário para apontar o app para um Postgres.
#
# No Streamlit Community Cloud: cole o conteúdo abaixo (com a URL real) em
# App → Settings → Secrets. Não faça upload deste arquivo para o GitHub.

# Senha de acesso ao app (portão de login). Sem ela, o app fica bloqueado.
[auth]
password = "DEFINA_UMA_SENHA_FORTE"

[database]
# Connection string do seu Postgres (Neon, Supabase, etc.).
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco?sslmode=require
url = "postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?sslmode=require"
